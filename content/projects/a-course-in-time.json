  "decisions": [
    {
      "decision": "Treat time closing around the player as a death, not a glitch",
      "detail": "The era system swaps collision layers, object state and physics in step. A crush check catches the moment solid geometry from the other era would occupy the player's space.",
      "why": {
        "status": "confirmed",
        "value": "So that time closing around the player reads as a death — a rule of the world — rather than a glitch."
      },
